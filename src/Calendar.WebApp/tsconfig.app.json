{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noImplicitOverride": true,

    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/__integration__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "e2e"
  ]
}
